    {
      "id": "claim_bb3888fc67754764b8828e5bce9581be",
      "statement": "PairedFidelitySpec's rollout depth is recipe-primary: num_inference_steps defaults to None so build reads ctx.inference_recipe['num_inference_steps'] (falling back to the callback's own 15), the supervised shell fills that context field from the controlnet.num_inference_steps knob, and an explicit per-callback value overrides the recipe.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/paired_fidelity.py#L36-L75",
