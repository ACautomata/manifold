    {
      "id": "claim_8e024392c9104eafac0a116f583a8c37",
      "statement": "Construction is two-phase: CallbackRegistry.resolve (config-time) validates names + per-name knob dicts and returns constructed spec instances in names order (unknown name → KeyError, unknown knob → ValueError); CallbackRegistry.build (fit-prep) injects the runtime CallbackContext (module, vae, datamodule, inference_recipe, model_dir, seed, optional feature_net / feature_net_factory / real_latents) and returns the pl.Callback list. The split exists because generative callbacks (FID, PairedFidelity) need runtime objects that do not exist at config resolution.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/context.py#L17-L48",
          "version": "repo-lines-v1:sha256:68e4dc667f042163c1906b0d695116ed3cde6e50aa3edcee67c45fee3f78bf69:"
        },
        {
          "resource": "repo://src/manifold/training/callbacks/registry.py#L73-L112",
          "version": "repo-lines-v1:sha256:3d7771a57cea33ba534cb829e7c7670a61e39a7a9d581c893f0fc2a14e6f8289:"
        }
