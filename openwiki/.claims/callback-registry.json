    {
      "id": "claim_7729a1bec73948c5ba9737ac9ddb3df2",
      "statement": "Specs satisfy the CallbackSpec Protocol structurally — a build(ctx) method with no inheritance — and the runtime objects a spec may inject are carried in the frozen CallbackContext (module, vae, datamodule, inference_recipe, model_dir, seed, feature_net / feature_net_factory, real_latents).",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/context.py#L17-L48",
          "version": "repo-lines-v1:sha256:68e4dc667f042163c1906b0d695116ed3cde6e50aa3edcee67c45fee3f78bf69:"
