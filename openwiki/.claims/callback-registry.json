    {
      "id": "claim_791e36f80c06403783999c2235a70dd3",
      "statement": "CallbackRegistry maps callback names to spec dataclasses and splits construction in two phases: resolve(names, cfg) at config time (fail-fast — KeyError with the registered set on an unknown name, ValueError with the allowed knob set on an unknown knob) and build(specs, ctx) at fit-prep time, which injects the CallbackContext into each spec.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/registry.py#L52-L112",
          "version": "repo-lines-v1:sha256:559ed1b1396644b7cc358534c6c6857b1f6835fc00d554291cae31e7ed58015f:"
        },
        {
