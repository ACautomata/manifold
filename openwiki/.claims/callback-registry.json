    {
      "id": "claim_07d3d5efd0f54489ad3045732b8ab445",
      "statement": "The registry is per-`TrainingSpine` instance and each shell registers only the names it supports — JiT registers `train_loss` / `fid` / `checkpoint`, the supervised ControlNet shell registers `train_loss` / `checkpoint` / `paired_fidelity`, GRPO registers `train_loss` / `fid` / `checkpoint`, and the reward shell registers `train_loss` / `checkpoint` — so a name another CLI supports is an unknown name (`KeyError`) for a given CLI.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/cli.py#L221-L224",
          "version": "repo-lines-v1:sha256:6486e2855500720d481deb78df23192e7b9b1dbca7b00a3cf0f3343be0716b3b:"
