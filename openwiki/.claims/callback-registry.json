        }
      ]
    },
    {
      "id": "claim_cecc03c40ba349009581fc3cbb5eedab",
      "statement": "The GRPO shell forbids FID for a ControlNet policy both at default-derivation and post-merge, passing `forbidden_callbacks={\"fid\": ...}` and `forbidden_monitors={\"val/fid\": ...}` to the spine, because the unconditional FID rollout ignores the trainable ControlNet and would be a constant frozen-base metric; the spine expresses that policy generically with no GRPO vocabulary.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/core.py#L113-L131",
          "version": "repo-lines-v1:sha256:3b5a165185184bdc1795067e0f26ca13950d7ffa361f1e48f4d9d9dcc5b55d4d:"
