    {
      "id": "claim_8a4f182099ff4b1f9e0bad80f258eb6d",
      "statement": "CallbackRegistry (ADR-0029) is the typed name→spec dispatcher that replaces the per-CLI _build_callbacks/_build_checkpoint clones, and TrainingSpine (ADR-0032) is the single caller of that registry; every training CLI ends with `spine.run(...)`.",
      "evidence": [
        {
          "resource": "repo://docs/adr/0029-callback-registry.md",
          "version": "repo-file-v1:sha256:33fc8883e982c7acd91a0acbace0f086904656c5d3dccfe1880f5466ac8b136e"
        },
