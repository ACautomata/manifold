  "claims": [
    {
      "id": "claim_2f100e8dfdce4f698acc9301566b8b27",
      "statement": "CallbackRegistry maps a callback name to a spec dataclass class: register() rejects anything that is not a @dataclass with a TypeError, and resolve() fails fast at config time — an unknown name raises KeyError listing the registered names, and an unknown knob for a known name raises ValueError listing that spec's allowed fields — before any Lightning callback is constructed.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/registry.py#L58-L108",
          "version": "repo-lines-v1:sha256:f9da9224e75a3da64cdc16a420ccecf983dcb8047e19b4c67ef331cfc726ac68:"
        }
      ]
    },
    {
      "id": "claim_cd3cbe17501041a28dc29c832bf66d5a",
      "statement": "A callback spec is a dataclass whose fields are the callback's config knobs and whose build(ctx) method constructs the pl.Callback from the runtime CallbackContext; specs match the CallbackSpec Protocol structurally without inheriting it, and logged_metrics is declared as a ClassVar so it never enters the knob allow-list that resolve() validates against.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/fid.py#L27-L66",
          "version": "repo-lines-v1:sha256:49d523d9cf2670334cba0ca9c135af8fffd93f8141f0bb14c98d70f932d9e944:"
        },
        {
