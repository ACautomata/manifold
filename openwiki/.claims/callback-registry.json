        }
      ]
    },
    {
      "id": "claim_2ef0e62a49ed406cb260571f2cacac88",
      "statement": "The four built-in specs are TrainLossSpec (no knobs; logs train/loss_epoch), FIDSpec (num_synth / every_n_epochs / center_slices_ratio / cov_ridge; logs val/fid), CheckpointSpec (monitor_metric / save_top_k / save_last / every_n_epochs / mode / filename) and PairedFidelitySpec (subset_size / every_n_epochs / num_inference_steps / seed; logs val/psnr and val/ssim).",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/checkpoint.py#L25-L64",
          "version": "repo-lines-v1:sha256:1e54952111ad9dd581234402b48bae180d61939acf867166df36172b6615cb8a:"
