        }
      ]
    },
    {
      "id": "claim_35070f4e42dc4de88002f831aab8a644",
      "statement": "A registered spec must be a @dataclass (register raises TypeError otherwise); its dataclass fields are exactly the knob allow-list resolve validates against, and logged_metrics is declared as a ClassVar so it stays out of that allow-list.",
