          "version": "repo-lines-v1:sha256:f2c1ea738cb913432c8fc19ed929cc447fc6b8195dbf2e0a98c356ed65fd0e8b:"
        },
        {
          "resource": "repo://src/manifold/training/callbacks/registry.py#L30-L56",
          "version": "repo-lines-v1:sha256:b398ea2cd6d90c3e801a276eec06d5d16f0875f85eb8ce461288d0c7d13f6246:"
        }
      ]
    },
    {
      "id": "claim_7be6993a3e8a4ecabd216cce057c61c0",
      "statement": "CallbackContext is the frozen runtime-objects bag injected at build time (module, vae, datamodule, inference_recipe, model_dir, seed, feature_net, feature_net_factory, real_latents); it exists so a spec needing runtime objects that do not exist at config resolution can still be constructed in the second phase.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/context.py#L16-L48",
          "version": "repo-lines-v1:sha256:2d3731bccf2fbe41eda0d03c90d3577800d9831cfef1cf6722313fcd73e9f8fe:"
