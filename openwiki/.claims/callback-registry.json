    {
      "id": "claim_228cccd73a3c4ccb8a6eb9f3ae572311",
      "statement": "Every spec is a `@dataclass` whose fields are the callback knobs (defaults) and which implements `build(self, ctx: CallbackContext) -> pl.Callback`; specs match the CallbackSpec Protocol structurally (no inheritance). CallbackRegistry.register enforces `@dataclass` so the unknown-knob allow-list built from `dataclasses.fields(spec_cls)` is always available.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/checkpoint.py#L25-L64",
          "version": "repo-lines-v1:sha256:1e54952111ad9dd581234402b48bae180d61939acf867166df36172b6615cb8a:"
