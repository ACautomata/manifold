    {
      "id": "claim_4c491de946c14060bf086129446a0b8f",
      "statement": "validate_monitor runs after resolve/build and before the trainer: a checkpoint monitor_metric is accepted only if it appears in the union of every spec's logged_metrics, the module's logged_metrics, and each extra callback's logged_metrics; an explicit monitor_metric=None bypasses the check, and a metric nobody logs raises ValueError before Lightning can fail mid-fit.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/registry.py#L114-L154",
          "version": "repo-lines-v1:sha256:af95f5276d1be7a22b7e75a5b7011bdbe4161b0dcf37dda3ba850149d5855b7e:"
        },
