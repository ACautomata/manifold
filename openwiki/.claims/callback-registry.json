          "version": "repo-lines-v1:sha256:bf94d9a816655fcf3e8e7ef059fc105ce60ef3522228f4fb83891f31370d88c5:"
        }
      ]
    },
    {
      "id": "claim_82237ed4fd874f8ba955adc3f3239ac2",
      "statement": "TrainingSpine.run owns the whole callback pipeline for every training shell: it takes the per-shell default names (or a full --callbacks replacement), applies forbidden_callbacks force-removal and forbidden_monitors rejection after the merge and before resolution, then resolves, builds, appends extra callbacks, validates the monitor, requires a ModelCheckpoint (raising ValueError when none survives instead of a deep StopIteration), builds the trainer, fits, and returns (trainer, ckpt).",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/core.py#L42-L162",
          "version": "repo-lines-v1:sha256:1dd42fd3ea9705af9c779b202fadfc2e98f98f7fb61f231634d6540dc59a9535:"
