    {
      "id": "claim_5be087ed418446ac980d0aa1c8707f5b",
      "statement": "`CheckpointSpec.build` reproduces the prior `_build_checkpoint` two-branch construction: the unmonitored branch (`monitor_metric=None`) hard-codes `save_top_k=1`, applies the `every_n_epochs` cadence and the filename `unet3d-{epoch:03d}-{step}`, while the monitored branch uses `monitor` / `mode` / `save_top_k` and the filename `unet3d-{epoch:03d}-{step}-{monitor:.3f}` — so `every_n_epochs` affects only the unmonitored branch and `save_top_k` only the monitored one.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/checkpoint.py#L42-L64",
          "version": "repo-lines-v1:sha256:d2c33beb89b47b3d9556ee790d31610d241a54ae2f21f84daa7a5bd6197b2adc:"
        }
