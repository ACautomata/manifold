    {
      "id": "claim_ec5311d61e6a439f86160135f619d83e",
      "statement": "The CLI/YAML callback-name list is resolved by resolve_callback_names: a comma-separated --callbacks string replaces the YAML callbacks list entirely, and when neither is supplied the function returns None so the shell keeps its derived default name set.",
