    {
      "id": "claim_cabc507e1dde46288d8d05dfae855769",
      "statement": "Each shell derives a dynamic default callback-name set: JiT starts from `[\"train_loss\"]`, adds `\"fid\"` when FID is attached and appends `\"checkpoint\"`; the supervised ControlNet shell uses `[\"train_loss\", \"checkpoint\", \"paired_fidelity\"]`; GRPO uses `[\"checkpoint\"]` (appending `\"fid\"` only when the FID triple is active and no ControlNet is present); and the reward shell uses `[\"checkpoint\"]`.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/cli.py#L226-L241",
