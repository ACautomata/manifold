    {
      "id": "claim_e57e1a30b3394d2aa3841f16f862d308",
      "statement": "CheckpointSpec.build keeps two branches: the unmonitored fallback (monitor_metric=None) saves the latest periodic checkpoint with save_top_k=1 plus last.ckpt at the every_n_epochs cadence under the filename unet3d-{epoch:03d}-{step}, while the monitored branch tracks monitor_metric with the configured mode and save_top_k under unet3d-{epoch:03d}-{step}-{monitor:.3f}.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/checkpoint.py#L42-L64",
          "version": "repo-lines-v1:sha256:d2c33beb89b47b3d9556ee790d31610d241a54ae2f21f84daa7a5bd6197b2adc:"
        }
