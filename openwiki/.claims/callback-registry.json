    {
      "id": "claim_cd30f7d208714db596b964c694dae1bd",
      "statement": "The paired-fidelity monitor is exported from manifold.training.callbacks and registered by the supervised ControlNet shell under the name 'paired_fidelity'; that shell's default callback set is ['train_loss', 'checkpoint', 'paired_fidelity'], its checkpoint monitor stays val/x0_mae, and LatentX0MAE is hand-appended as an extra callback.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/__init__.py#L14-L29",
          "version": "repo-lines-v1:sha256:64c3a8aa31289e593919d410a09dc2addd0f8f51e1caead5b1efb9e3c6369453:"
