    {
      "id": "claim_5db6fd1348cc4b45b77ea614028316c8",
      "statement": "On each gated validation epoch the paired-fidelity callback scores a cached fixed seeded subset under freshly re-seeded noise through the module's own rollout under torch.inference_mode(), VAE-decodes the generated and real target through VaeStage/LatentDecoder, min-max normalizes both volumes to [0,1], scores them with the shared PairedFidelityMetrics, and logs only val/psnr and val/ssim through module-attached MeanMetrics that are reset each epoch.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired_callback.py#L167-L217",
          "version": "repo-lines-v1:sha256:a158626449cf7ec3713628288a31f4c41a2dd446f024b064e213c436406d57fb:"
