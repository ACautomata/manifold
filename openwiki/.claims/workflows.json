    {
      "id": "claim_31ed77ba65864d49bfc06a5d6b3a1cf0",
      "statement": "manifold-train-controlnet is the supervised paired translator (ADR-0027 stage 1) that loads a frozen JiT native export via --native-dir, warms per-volume latents through the shared PairedLatentDataset, and trains a trainable ControlNet on the frozen base UNet through ControlNetLatentFlowModule. The frozen base is held unregistered by the Module (off the optimizer and the checkpoint) per FrozenArmMixin (ADR-0031 A1), and the supervised native export becomes the stage-1 input to manifold-train-grpo for the ControlNet policy path.",
      "evidence": [
        {
          "resource": "repo://docs/adr/0027-controlnet-supervised-then-grpo-two-stage.md",
          "version": "repo-file-v1:sha256:97503c626a258eb852e94045824a0f8f63743a628ab318b78c6276f4f7bedb85"
