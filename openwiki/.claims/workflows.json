    {
      "id": "claim_24a04565741a42ada7100736a3620b85",
      "statement": "The GRPO rollout walks two slices per branch — the anchor slice 0 → max_k (one Heun trajectory across the deterministic prefix, shared by every sibling) and the per-sibling suffix slice k+1 → n (the stochastic branch that produces the GRPO group) — both routed through FlowMatchGRPOScheduler.rollout_range, a method on the GRPO scheduler rather than a free function in grpo.py. PartialFlowMatchHeunScheduler and FlowMatchGRPOScheduler both inherit heun_rollout from FlowMatchHeunDiscreteScheduler by identity.",
      "evidence": [
        {
          "resource": "repo://src/manifold/modules/grpo.py#L88-L219",
          "version": "repo-lines-v1:sha256:e43c984ced5f2552ae706b1f0ed84a1ab17e78485518cbb611d82fb3db004c3d:"
