    {
      "id": "claim_d318092a5d5845f492244a9e5737a9d8",
      "statement": "manifold-eval refuses to estimate a new VAE scaling factor: it uses the before export's vae.scaling_factor verbatim for both sides, and the ControlNet path requires a held-out val split and a warmed paired latent cache (no empty val or cache-miss fallback). The eval refilters pairs by --src-label / --tgt-label, caps at --num-pairs, and writes metrics.json plus slice_grid_<i>.png.",
