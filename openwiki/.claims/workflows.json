    {
      "id": "claim_64c855060d28492eaa148cfbfb812096",
      "statement": "manifold-train-grpo trains either the UNet policy or a supervised ControlNet policy through one recipe (configs/train/config_grpo.yaml) and one module (GRPOModule); the policy is inferred from the native artifact passed to --native-dir — a raw JiT export trains the UNet, a supervised ControlNet export trains the ControlNet on the frozen base — with no --grpo-mode flag. grpo_train.lr is the UNet default; optional controlnet.lr applies only on the ControlNet path and falls back to grpo_train.lr when absent.",
      "evidence": [
        {
          "resource": "repo://configs/train/config_grpo.yaml",
          "version": "repo-file-v1:sha256:84fcdfe444eea9c0b0fd7cf5e6c1417c29b88208cbbb58a505a81911d4309910"
