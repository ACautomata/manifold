          "version": "repo-lines-v1:sha256:dd122d6dc1889d50fab432e7bf7aaee3d34496e86896526cef80d6f922291a9e:"
        }
      ]
    },
    {
      "id": "claim_77ab9062983543398ac63cbfc2f3c5f8",
      "statement": "The monitor generates through the training module's own full Heun ControlNet rollout (`ControlNetLatentFlowModule.sample` delegating to `controlnet_rollout`) under `torch.inference_mode`, so the monitor forms no gradient and its numbers reflect the deployed multi-step translation rather than a one-step decode proxy.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired_callback.py#L170-L205",
          "version": "repo-lines-v1:sha256:edacd8b755651eb49cdf7cbc8dc9e80697cd9d0a4a50d56bd28ee0cafcd66ed7:"
        },
        {
