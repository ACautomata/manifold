        }
      ]
    },
    {
      "id": "claim_c4707c642f554d6795e6ec251cd63c36",
      "statement": "The launch-time experiment config (OmegaConf, composed env → train → network with whole top-level replacement and `_base_` inheritance) and the persisted component config (the JSON `config.json` a component writes via `register_to_config` / `ConfigMixin`) are two distinct layers: the experiment config builds components and is never persisted, while the component config round-trips independently of how the component was launched.",
      "evidence": [
        {
          "resource": "repo://CONTEXT.md",
          "version": "repo-file-v1:sha256:699cfc96f28ee81cde3fd8f1af0ccf82dd9c755fbce32ffc41633379f7031864"
