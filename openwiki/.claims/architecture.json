    {
      "id": "claim_5af2dd07b9224438bbc43b0faf5ac18f",
      "statement": "Native inference directories hold per-component configuration and weights plus a `model_index.json`; Lightning `.ckpt` files are training state that pipelines never load directly, so the one-shot export is the sole bridge from a training checkpoint to an inference pipeline.",
      "evidence": [
