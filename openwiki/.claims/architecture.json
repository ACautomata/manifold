          "version": "repo-lines-v1:sha256:900027701b76a50196a2371bb45767b6560e54bff496f5482d88df79e499682f:"
        }
      ]
    },
    {
      "id": "claim_97a49efb151741548184af74196a64c8",
      "statement": "The monitor's rollout step count is recipe-primary: the supervised CLI reads `controlnet.num_inference_steps` (default 15), passes it through `CallbackContext.inference_recipe`, and `PairedFidelitySpec.build` takes it from there, with the spec's own `num_inference_steps` field acting only as a per-callback override.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/paired_fidelity.py#L37-L75",
          "version": "repo-lines-v1:sha256:f2c1ea738cb913432c8fc19ed929cc447fc6b8195dbf2e0a98c356ed65fd0e8b:"
