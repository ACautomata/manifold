    {
      "id": "claim_d86a76fc704542799222136ff53cfe47",
      "statement": "In the supervised ControlNet stage the frozen base UNet is registered and dual-excluded through `FrozenArmMixin`, so it sits on the module tree where Lightning owns device placement while carrying no gradient and emitting no checkpoint key; the ControlNet is the only optimized and checkpointed arm.",
      "evidence": [
        {
          "resource": "repo://src/manifold/modules/controlnet_latent_flow.py#L140-L170",
          "version": "repo-lines-v1:sha256:fd9a2d38729667129209f1d6e7673b87423c0d9b8a124f365185d423dc56b02d:"
