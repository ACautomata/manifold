    {
      "id": "claim_e66d97493edc43c5ac674f95dd630df8",
      "statement": "Training callbacks are wired only through the two-phase `CallbackRegistry` (resolve at config time, build at fit-prep time) plus `TrainingSpine.run`'s merge order; a spec declares `logged_metrics` so a metric can be validatable by `validate_monitor` without owning checkpoint selection, and post-merge `forbidden_callbacks` / `forbidden_monitors` can remove callbacks or reject a monitor metric that no YAML or CLI override can re-enable.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/paired_fidelity.py#L53-L60",
          "version": "repo-lines-v1:sha256:9df364a5ff5dc8f20df7b3f58a1f9b791e951a6b2abbf1556994ca38bf664352:"
        },
        {
