    {
      "id": "claim_8f35a279045c42519d554e9ed7124624",
      "statement": "The ControlNet's direction conditioning concatenates the source label embedding with the offset target label embedding (`concat([embed(src), embed(tgt+offset)])`), while the `x_src` control latent is embedded and added to the input embedding rather than channel-concatenated with `z_t`; the frozen base UNet is conditioned only on the target label.",
      "evidence": [
        {
          "resource": "repo://src/manifold/models/controlnet_3d.py#L248-L300",
          "version": "repo-lines-v1:sha256:04338cc09227c1d065abfe48c7f0b8c45b912db02aff1d5641b7594b3a2b56ff:"
