    {
      "id": "claim_76ca8d7541a440c38bd6ece6dadaeb16",
      "statement": "`PairedFidelityMetrics` composes MONAI's `PSNRMetric(max_val=1.0)` and `SSIMMetric(spatial_dims=3, data_range=1.0)`, batch-means both outputs, raises a clear `ValueError` on a generated/real shape mismatch, and reports PSNR as `+inf` for identical volumes rather than clamping it.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired.py#L26-L66",
