    {
      "id": "claim_bf9c0bda14834361a4b922624317bd4f",
      "statement": "The monitor's rollout step count is recipe-primary: `PairedFidelitySpec.num_inference_steps=None` reads `ctx.inference_recipe[\"num_inference_steps\"]`, and the supervised CLI fills that field from the existing `controlnet.num_inference_steps` recipe knob via `CallbackContext(inference_recipe={\"num_inference_steps\": int(num_inference_steps)}, ...)` in `run_controlnet_training`; an explicit per-callback knob overrides the recipe, and a recipe-less context falls back to the callback's own default of 15 Heun steps.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/callbacks/context.py#L17-L48",
          "version": "repo-lines-v1:sha256:68e4dc667f042163c1906b0d695116ed3cde6e50aa3edcee67c45fee3f78bf69:"
