    {
      "id": "claim_9170ea75d1ba468285549084cb5658e4",
      "statement": "The monitor is observe-only: it never drives checkpoint selection (the supervised shell's checkpoint monitor stays val/x0_mae, the fast latent surrogate logged by the hand-appended LatentX0MAE), never enters the loss, never touches the optimizer or EMA, and writes no samples or artifacts; declaring logged_metrics = {\"val/psnr\", \"val/ssim\"} only makes those two names validatable monitors through CallbackRegistry.validate_monitor, it is not a switch that turns them on as a monitor.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired_callback.py#L79-L84",
          "version": "repo-lines-v1:sha256:e3049968b7e9baeb8457c25544ef59c7d0eac2d76d081c37ddd3c46de82fa7d1:"
        },
