    {
      "id": "claim_e252a09c830c44a4ad3cc12d46310566",
      "statement": "PairedFidelitySpec exposes four knobs — subset_size (8), every_n_epochs (1), num_inference_steps (None) and seed (0) — and resolves the rollout step count as per-callback knob, then ctx.inference_recipe[\"num_inference_steps\"], then the callback's own default of 15; the supervised shell fills CallbackContext.inference_recipe from the existing controlnet.num_inference_steps config knob (default 15), so the recipe is the single source of truth and the spec knob is an override.",
      "evidence": [
        {
          "resource": "repo://configs/train/config_controlnet_supervised.yaml#L46-L50",
          "version": "repo-lines-v1:sha256:305366838c888e2779aff8f8422f1af7c7d1355518e2c9151c3e4627e7fbc144:"
        },
