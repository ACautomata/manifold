          "version": "repo-lines-v1:sha256:a0436e1e8c051bffd8d3f5c2ee9b8836d643be86eb843d0a1f1ec5f356fdaa01:"
        }
      ]
    },
    {
      "id": "claim_25dea33d2e184135a6cd9153baf00671",
      "statement": "The eval stack is dependency-injected end to end — the fidelity scorer and the grid renderer are constructor arguments of `BeforeAfterEval`, and the CLI's real ControlNet data loading is replaceable through the `pairs_provider` seam — so the whole workflow runs on CPU with tiny components and no real checkpoints.",
      "evidence": [
        {
          "resource": "repo://src/manifold/eval/before_after.py#L60-L78",
          "version": "repo-lines-v1:sha256:ad494a2c99d07bf621b16a059dd9fd0a14d63cc287bd4c71a07140a931b24e17:"
