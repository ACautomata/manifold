          "resource": "repo://docs/adr/0037-controlnet-fidelity-in-training-monitor.md#L49-L63",
          "version": "repo-lines-v1:sha256:273ec2df3717bee29e28151c18c22b6f391dbc13bf436763cb1a8410521c4427:"
