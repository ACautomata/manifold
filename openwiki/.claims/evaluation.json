        }
      ]
    },
    {
      "id": "claim_ae14819d8c6c4ce7b8896ca3304ad17a",
      "statement": "The offline eval writes one 2.5D three-plane slice-grid PNG per sample plus a metrics.json recording the policy, seed, inference-step count, sample count, the grid basenames (not full paths, so the report stays portable if the directory moves) and, on the paired policy, the before/after PSNR/SSIM; the grid PNG and the HTML report are written through a tmp file plus os.replace atomic rename.",
      "evidence": [
        {
          "resource": "repo://src/manifold/eval/before_after.py#L196-L255",
          "version": "repo-lines-v1:sha256:02781c7f7718284f290472d409276eacae3c89aba64594a35f7bcd67b7de609c:"
