    {
      "id": "claim_0c1093df4fa74a7dba54500e9b588dac",
      "statement": "Under DDP the monitor is redundant rather than sharded: every rank evaluates the same fixed subset with DDP-synchronized weights, identical fixed input and the same re-seeded noise, so the only cross-rank interaction is Lightning's torchmetrics sync on the two logged MeanMetrics — no FID-style subset sharding and no error-rendezvous machinery — and the accepted cost is a full Heun rollout plus a VAE decode per gated epoch on every rank (29 UNet evaluations at the default 15 steps, since the final Heun step is Euler-only).",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired_callback.py#L196-L215",
          "version": "repo-lines-v1:sha256:92a217a5df86f71046efb2ff4be4d7b613673da12bc9cc990b1180ba29ec3125:"
        },
