    {
      "id": "claim_8e971b25da6f4c72b3d7bde8e2a99fac",
      "statement": "`PairedFidelityMetrics` composes MONAI's `PSNRMetric(max_val=1.0)` and `SSIMMetric(spatial_dims=3, data_range=1.0)` (composition, not inheritance), operates on `[B, C, D, H, W]` volumes already in `[0, 1]`, and reduces to batch-mean scalars; identical volumes yield `+inf` PSNR (zero error) and SSIM == 1.0, and `min_max_to_unit` normalizes each volume independently with degenerate zero-range inputs mapped to zeros.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired.py#L26-L66",
          "version": "repo-lines-v1:sha256:00fb7c01bf2323cb76bbd04326582f647905a132a9d478a3f3245285c861ec20:"
