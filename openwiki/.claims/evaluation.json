        }
      ]
    },
    {
      "id": "claim_087646ba890648bb9b813c3a593063f9",
      "statement": "Each sample is written as one 2.5D three-plane slice-grid PNG (rows xy/yz/zx) whose columns are `before | after` for JiT and `before | after | real target` for ControlNet, and the PNG is written atomically through a temporary file plus `os.replace`.",
      "evidence": [
