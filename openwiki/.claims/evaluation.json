    {
      "id": "claim_5709867748f44f92a260eefc202429c6",
      "statement": "The ADR-0037 in-training paired-fidelity monitor is implemented: `PairedFidelityCallback` runs on `on_validation_epoch_end`, translates a fixed paired subset through the module's own full Heun rollout under `inference_mode`, decodes the generated and real target through the staged VAE, min-max normalizes both, scores them with the same `PairedFidelityMetrics` the offline pass uses, and logs `val/psnr` and `val/ssim`.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired.py#L34-L66",
          "version": "repo-lines-v1:sha256:63ba2b62f6a540d4a824f5d4e19571e2699658897e9a0f2bacac56064883a963:"
        },
        {
