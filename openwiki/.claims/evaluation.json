  "claims": [
    {
      "id": "claim_5f84e6e605304b2a85b2681dc9a73c85",
      "statement": "The offline before/after eval enforces a same-noise pairing contract so a before/after difference is attributable to policy weights rather than sampling stochasticity: the unconditional JiT path hands each pipeline a fresh torch.Generator seeded identically on the pipeline device, and the paired ControlNet path draws one start-noise tensor for the batch and passes the same tensor to both pipelines' sample_latent calls, with the source latent, real target latent, spacing, contrast labels and Heun step count held fixed.",
      "evidence": [
        {
          "resource": "repo://src/manifold/eval/before_after.py#L104-L160",
          "version": "repo-lines-v1:sha256:95a7c41109caf67e8e859b319d6f66257c7be2c62ad24c129e098a3cb19bc328:"
        },
        {
          "resource": "repo://src/manifold/eval/before_after.py#L163-L200",
          "version": "repo-lines-v1:sha256:0fe0faada552d9e46ff4a958d23904a0bc44abc1def3d2c0f6e4264b2b730d04:"
        }
      ]
    },
    {
      "id": "claim_ba2158669be747e29e621143e8032b0e",
      "statement": "The eval entry infers the policy from the before native artifact rather than a mode flag: _pipeline_class_of reads pipeline_class from the before directory's model_index.json and routes LatentFlowPipeline to the unconditional pass and ControlNetLatentFlowPipeline to the paired pass, failing fast with the supported class list for an unknown one.",
      "evidence": [
        {
          "resource": "repo://src/manifold/eval/cli.py#L132-L165",
          "version": "repo-lines-v1:sha256:2dff360e6a172ed549e51f000b8f245d179bcd3d36ec24864623bfe719ecde6a:"
        }
      ]
    },
    {
      "id": "claim_eb1fb0f64042401881b1c6647d20fb0f",
      "statement": "PairedFidelityMetrics composes MONAI PSNRMetric(max_val=1.0) and SSIMMetric(spatial_dims=3, data_range=1.0) over [B,C,D,H,W] volumes already normalized to [0,1], reports batch-mean psnr (dB) and ssim scalars, raises ValueError on a generated/real shape mismatch, and surfaces the +inf PSNR / 1.0 SSIM ceiling on identical volumes rather than clamping it.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired.py#L29-L66",
          "version": "repo-lines-v1:sha256:c30ea3d01212db15739da105ec9e051488a53ff8fece00caa0e9ac5cadae4e4e:"
        }
      ]
    },
    {
      "id": "claim_c150c3805ec64fc7ba11e481e1631f4d",
      "statement": "min_max_to_unit is the shared published-output normalization contract: it normalizes each decoded volume independently by its own min/max into [0,1] and maps a degenerate zero-range volume to zeros, and it is used by the ControlNet pipeline decode, the offline before/after eval driver, and the in-training paired-fidelity monitor, which is what lets the metric assume data_range = 1.0 everywhere.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired_callback.py#L203-L206",
          "version": "repo-lines-v1:sha256:acbc677e5933950c662fb34ff9f75ca497cad7f0f6ed18afa1fc3c7f756bc1e2:"
        },
        {
