    {
      "id": "claim_f651761f54d247c3bbf6b38ac6a071c3",
      "statement": "The ControlNet eval path refuses to reuse training data: it resolves the held-out validation split through the shared `_train_val_manifests` and fails when that split is empty, reads the warmed paired latent cache without ever encoding, applies the before export's VAE `scaling_factor` instead of re-estimating it, and requires `--data-base-dir` and `--latents-dir` unless a `pairs_provider` is injected.",
      "evidence": [
        {
          "resource": "repo://src/manifold/eval/cli.py#L176-L241",
          "version": "repo-lines-v1:sha256:ba5c509c9677d61909fbc2dbb59ce8de6eaf9c5ba32f9e6fbf1834692ef9b293:"
        },
        {
