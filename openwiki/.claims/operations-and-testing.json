          "version": "repo-lines-v1:sha256:bb1a558ae1294084763ac1a15733c0dc9035300d5a32efe9a6fbb4cd3506d73c:"
        }
      ]
    },
    {
      "id": "claim_dc088453f71f4493bda140685d9b1cf9",
      "statement": "The `PairedFidelityCallback` monitor is observe-only: it never drives checkpoint selection (`monitor_metric` stays `val/x0_mae` per the supervised ControlNet CLI), never enters the loss, and never touches the optimizer or EMA. The `paired_fidelity` spec is registered on the supervised ControlNet CLI's default callback list but remains forbidden on the ControlNet-GRPO path until the deliberate ADR-0037 GRPO-stage follow-up lands.",
      "evidence": [
        {
          "resource": "repo://docs/adr/0037-controlnet-fidelity-in-training-monitor.md#L19-L62",
          "version": "repo-lines-v1:sha256:9ea50cdb5dedadfb8deee4979aaacd43e017fe93d53bf90bf274e886ae0b50d4:"
        },
        {
