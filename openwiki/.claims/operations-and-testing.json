  "claims": [
    {
      "id": "claim_1b306a3eec35481ea402cfb901bc0918",
      "statement": "The supervised ControlNet training stage ships the observe-only `PairedFidelityCallback` (registered as `PairedFidelitySpec` in `src/manifold/training/callbacks/paired_fidelity.py`) as the in-training paired-fidelity monitor per ADR-0037. The callback runs the module's full Heun `controlnet_rollout` on a small fixed paired subset under fixed seeded noise, VAE-decodes both the generated and real target latents, normalizes them through the shared `min_max_to_unit` helper, and logs `val/psnr` / `val/ssim` through module-attached `torchmetrics.MeanMetric` instances.",
      "evidence": [
        {
          "resource": "repo://src/manifold/metrics/paired_callback.py#L1-L218",
          "version": "repo-lines-v1:sha256:ca5eef87bc78283982ff62c0630dba342153618f106adb4928089702e81bffa6:"
        },
        {
