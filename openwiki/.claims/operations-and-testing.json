          "version": "repo-file-v1:sha256:da16f9e2b3942ab44164e2c4caa3e03d40dec732b6ba55df9179395371802e01"
        }
      ]
    },
    {
      "id": "claim_e89838c2aba94034bd782dffa9308ca2",
      "statement": "The in-training `val/psnr` / `val/ssim` monitor and the offline `metrics.json` PSNR/SSIM share the same metric (`PairedFidelityMetrics`), the same per-volume `min_max_to_unit` normalization to `[0, 1]`, and the same float32 decode with MAISI `norm_float16` disabled. A change that breaks one side without the other is a comparison bug and crosses `src/manifold/pipelines/pipeline_utils.py`, `src/manifold/metrics/paired.py`, `src/manifold/metrics/paired_callback.py`, and `src/manifold/eval/before_after.py`.",
      "evidence": [
        {
          "resource": "repo://src/manifold/eval/before_after.py#L82-L94",
          "version": "repo-lines-v1:sha256:321a8fdec1fc36142709a26b0755561321573b61e005bbc81a77b60d56696667:"
        },
