    {
      "id": "claim_a071a14183ec4c45b3598a25b899e5d9",
      "statement": "The \"sleeping processes + stalled log + no tqdm\" triad is a known false positive for the DCU deadlock and must not be acted on without a load-bearing signal: `hy-smi` near 0% (stalled) versus ~100% (slow but computing), `SIGTERM` responsiveness (the 2026-07-14 stall required `SIGKILL`), or an identical frozen `sliding_window_inference -> _conv_forward` frame under `py-spy` on all ranks.",
      "evidence": [
        {
          "resource": "repo://docs/adr/0025-all-ddp-validation-no-rank0-gate.md#L81-L105",
          "version": "repo-lines-v1:sha256:124146c34bec49dbb07a6196ed31fb09ea23a339f18ab0ddd1267ce7e9a42396:"
        }
      ]
