    {
      "id": "claim_40bfa0cfc20a4a66ab32b4659527c2b3",
      "statement": "DevicePolicy construction is side-effect free: __init__ reads os.environ LOCAL_RANK once (missing defaults to 0), stores it, and touches neither CUDA nor the process group; the snapshot is taken at construction, so post-process-group callers never re-resolve the rank via dist.get_rank().",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/device_policy.py#L38-L44",
          "version": "repo-lines-v1:sha256:3f794df26df910da1499ac74b64803253519701382816dd03e355195c698f25c:"
        }
      ]
    },
    {
      "id": "claim_78c4fa869c4a43ca84848a3a6a5edeba",
      "statement": "DevicePolicy.pin() is the single pre-process-group side effect: when CUDA is available it calls torch.cuda.set_device(local_rank) only if local_rank is below torch.cuda.device_count() (an out-of-range LOCAL_RANK skips the call but still returns cuda:{local_rank}), and when CUDA is unavailable it returns cpu with no side effect at all.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/device_policy.py#L46-L54",
          "version": "repo-lines-v1:sha256:fc40b8a41be09bdbb1adbe332ac4376cef4283303408dae21a0ee1f6180c3718:"
        }
      ]
    },
    {
      "id": "claim_a6bd8d4ca80d4e47b1ee178b2f0f4509",
      "statement": "DevicePolicy.device() returns the same cuda:{local_rank} or cpu value as pin() but never calls set_device; it exists for read-only/debug paths and currently has no production call site — pin() and warm_device() are the only methods used by the training shells.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/controlnet_cli.py#L276-L290",
          "version": "repo-lines-v1:sha256:a6ee1c93307936ba23ba765f5b24be02728a1d406cceccd585452bf1f8c9368f:"
        },
        {
