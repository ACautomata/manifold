    {
      "id": "claim_6b60ed83920e4ab0a3145679ac89bae0",
      "statement": "DevicePolicy construction is side-effect free: __init__ snapshots the launcher's LOCAL_RANK env var once (missing → 0), touches neither CUDA nor the process group, and post-PG callers never re-resolve the rank via dist.get_rank().",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/device_policy.py#L41-L45",
