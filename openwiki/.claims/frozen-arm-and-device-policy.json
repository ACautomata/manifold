          "version": "repo-lines-v1:sha256:82bd6f1f91b94e73fb0447e1f6510857f96109ea1a6454340468335aaefb7ef5:"
        }
      ]
    },
    {
      "id": "claim_cb7d8e63cfb34b55af4782f13de033fb",
      "statement": "The mixin's train(mode) override re-applies eval() to every registered frozen arm after super().train(mode), because registration makes Lightning's recursive train(True) flip the arms back to training mode and a frozen arm's BatchNorm running stats must not drift during rollout or reward evaluation.",
      "evidence": [
        {
          "resource": "repo://src/manifold/modules/frozen_arm.py#L139-L154",
          "version": "repo-lines-v1:sha256:d9b2d8864c5dfb4e0d51c3bc39792d5165c79e8445b6d2ab672d38d101d60c11:"
