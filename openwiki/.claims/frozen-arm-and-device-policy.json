    {
      "id": "claim_68abe6bd04744829a7f2e2769c8712d1",
      "statement": "Each host declares only WHICH arms are frozen: GRPOModule registers the frozen base as `unet` on the ControlNet policy path, always registers `reward_model`, and registers the KL reference arms (`reference_unet` plus `reference_controlnet` on the ControlNet policy, `reference_unet` alone on the UNet policy); ControlNetLatentFlowModule registers `unet`; RewardModule registers the frozen `denoiser`.",
      "evidence": [
        {
          "resource": "repo://src/manifold/modules/controlnet_latent_flow.py#L128-L138",
          "version": "repo-lines-v1:sha256:cb115806d6710535da6b42e141a51880d7c2893a81a51965f266f21faad3ef5f:"
