    {
      "id": "claim_58fe7060d9dc4c018bf25a877da65b20",
      "statement": "DevicePolicy.device() is a side-effect-free read that returns the same cuda:{local_rank} (or cpu) value as pin() without ever calling set_device.",
      "evidence": [
        {
          "resource": "repo://src/manifold/training/device_policy.py#L57-L61",
